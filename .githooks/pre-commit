#!/usr/bin/env bash
# 提交前扫描：命中敏感内容就阻止提交。
# 安装：bash scripts/scan-sensitive.sh --install-hook   （或 git config core.hooksPath .githooks）
# 命中后脱敏再提交，禁止用 --no-verify 绕过。
set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"
[ -x "$REPO/scripts/scan-sensitive.sh" ] || exit 0
exec bash "$REPO/scripts/scan-sensitive.sh"
